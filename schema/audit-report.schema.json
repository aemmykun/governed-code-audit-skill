{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aemmykun/governed-code-audit-skill/schema/audit-report.schema.json",
  "title": "Audit report v0.2.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "audit_id": {
      "type": "string",
      "minLength": 1
    },
    "audit_status": {
      "enum": [
        "complete",
        "incomplete",
        "rejected"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "commit_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        }
      },
      "required": [
        "snapshot_id",
        "commit_sha"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requested": {
          "type": "array",
          "items": {
            "enum": [
              "security",
              "architecture",
              "compliance",
              "maintainability",
              "agent_governance"
            ]
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "assessed": {
          "type": "array",
          "items": {
            "enum": [
              "security",
              "architecture",
              "compliance",
              "maintainability",
              "agent_governance"
            ]
          },
          "uniqueItems": true
        },
        "blocked": {
          "type": "array",
          "items": {
            "enum": [
              "security",
              "architecture",
              "compliance",
              "maintainability",
              "agent_governance"
            ]
          },
          "uniqueItems": true
        }
      },
      "required": [
        "requested",
        "assessed",
        "blocked"
      ]
    },
    "missing_context": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "overall_risk": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "informational",
        "unknown"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "security",
              "architecture",
              "compliance",
              "maintainability",
              "agent_governance"
            ]
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "informational"
            ]
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "verification_status": {
            "enum": [
              "confirmed",
              "probable",
              "needs_human_review",
              "false_positive_candidate",
              "unverified"
            ]
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "snapshot_id": {
                "type": "string",
                "minLength": 1
              },
              "file": {
                "type": "string",
                "minLength": 1
              },
              "line_start": {
                "type": "integer",
                "minimum": 1
              },
              "line_end": {
                "type": "integer",
                "minimum": 1
              },
              "excerpt": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "enum": [
                  "static_inspection",
                  "supplied_test_result",
                  "trusted_scanner_result"
                ]
              }
            },
            "required": [
              "snapshot_id",
              "file",
              "line_start",
              "line_end",
              "excerpt",
              "method"
            ]
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title",
          "category",
          "severity",
          "confidence",
          "verification_status",
          "evidence",
          "impact",
          "recommendation"
        ]
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "release_gate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "const": "not_evaluated"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "state",
        "reason"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skill_version": {
          "const": "0.2.0"
        },
        "input_digests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ]
          }
        },
        "signed": {
          "const": false
        }
      },
      "required": [
        "skill_version",
        "input_digests",
        "signed"
      ]
    }
  },
  "required": [
    "schema_version",
    "audit_id",
    "audit_status",
    "source",
    "scope",
    "missing_context",
    "overall_risk",
    "findings",
    "observations",
    "limitations",
    "release_gate",
    "provenance"
  ]
}
